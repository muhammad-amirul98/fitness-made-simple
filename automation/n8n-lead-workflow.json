{
  "name": "Fitness Made Simple SG - Lead Notifications",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "responseMode": "onReceived",
        "responseData": "{\"status\":\"success\"}",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4a1a-9a1a-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "// landing.js posts JSON as text/plain (no-cors workaround), so n8n won't\n// auto-parse it. Handle raw string, Buffer, or already-parsed object.\nlet raw = $input.item.json.body;\nif (Buffer.isBuffer(raw)) raw = raw.toString('utf8');\nif (typeof raw === 'object' && raw !== null) return [{ json: raw }];\nreturn [{ json: JSON.parse(raw) }];"
      },
      "id": "a1b2c3d4-0002-4a1a-9a1a-000000000002",
      "name": "Parse lead data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "1shgctLpiUQLHnJn_ML9G_LdL47zMeNqp76W5N5USmQY",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $now.setZone('Asia/Singapore').toFormat('dd LLL yyyy, HH:mm:ss') }} SGT",
            "Form Type": "={{ $json.formType || '' }}",
            "Name": "={{ $json.name || '' }}",
            "Email": "={{ $json.email || '' }}",
            "Phone": "={{ $json.phone || '' }}",
            "Package": "={{ $json.package || '' }}",
            "Source": "={{ $json.source || '' }}",
            "Message": "={{ $json.message || '' }}",
            "Age": "={{ $json.age || '' }}",
            "Gender": "={{ $json.gender || '' }}",
            "Preferred Days": "={{ $json.timingDays || '' }}",
            "Preferred Times": "={{ $json.timingBlocks || '' }}",
            "Goal": "={{ $json.goal || '' }}",
            "Experience": "={{ $json.experience || '' }}",
            "Equipment": "={{ $json.equipment || '' }}",
            "Days/Week": "={{ $json.days || '' }}",
            "Session Length": "={{ $json.duration || '' }}",
            "Limitations": "={{ $json.limitations || '' }}",
            "Notes": "={{ $json.notes || '' }}"
          }
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4a1a-9a1a-000000000003",
      "name": "Log to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [640, 300],
      "notesInFlow": true,
      "notes": "Sheet ID matches README. Double-check the tab name — 'Sheet1' is a placeholder for whatever the active tab is actually called."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{ $json.email }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-4a1a-9a1a-000000000004",
      "name": "Has email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [860, 300]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "Thanks for reaching out — Fitness Made Simple SG",
        "message": "=Hi {{ $json.name || '' }},\n\nThanks for getting in touch! I'll personally reply within 24 hours.\n\n— Amirul, Fitness Made Simple SG",
        "options": {}
      },
      "id": "a1b2c3d4-0005-4a1a-9a1a-000000000005",
      "name": "Send autoresponder",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1080, 200],
      "webhookId": "gmail-autoresponder"
    },
    {
      "parameters": {
        "sendTo": "fitnessmadesimplesg@gmail.com",
        "subject": "=New lead: {{ $json.name || 'Unknown' }} ({{ $json.package || 'no package selected' }})",
        "message": "=New {{ $json.formType === 'detailed' ? 'full intake' : 'quick inquiry' }} submitted\n\n--- SUBMISSION ---\nName: {{ $json.name || '' }}\nEmail: {{ $json.email || '' }}\nPhone: {{ $json.phone || '' }}\nPackage: {{ $json.package || '' }}\nSource: {{ $json.source || '' }}\n{{ $json.message ? 'Message: ' + $json.message + '\\n' : '' }}{{ $json.goal ? 'Goal: ' + $json.goal + '\\n' : '' }}{{ $json.experience ? 'Experience: ' + $json.experience + '\\n' : '' }}{{ $json.equipment ? 'Equipment: ' + $json.equipment + '\\n' : '' }}{{ $json.days ? 'Days/week: ' + $json.days + '\\n' : '' }}{{ $json.duration ? 'Session length: ' + $json.duration + '\\n' : '' }}{{ $json.limitations ? 'Injuries/limitations: ' + $json.limitations + '\\n' : '' }}{{ $json.notes ? 'Notes: ' + $json.notes + '\\n' : '' }}",
        "options": {}
      },
      "id": "a1b2c3d4-0006-4a1a-9a1a-000000000006",
      "name": "Notify owner",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1300, 300],
      "webhookId": "gmail-notify-owner"
    }
  ],
  "connections": {
